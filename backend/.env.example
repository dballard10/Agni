# Agni Backend Environment Configuration
# Copy this file to .env and fill in the values.

# Supabase Configuration
# Get these from `npm run supabase:status` (local) or Supabase dashboard (cloud)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# CORS Configuration
# Comma-separated list of allowed origins for cross-origin requests.
#
# For local development with multiple clients:
#   - Web (Vite):        http://localhost:5173
#   - Desktop (Electron): http://localhost:5173 (uses same Vite server)
#   - Mobile (Expo):      http://<YOUR_LOCAL_IP>:8081 or device IP
#
# To find your local IP:
#   macOS:   ipconfig getifaddr en0
#   Linux:   hostname -I
#   Windows: ipconfig (look for IPv4 Address)
#
# Example for local dev with mobile:
#   CORS_ORIGINS=http://localhost:5173,http://192.168.1.100:5173,http://192.168.1.100:8081
#
# For production, use your actual deployed domain:
#   CORS_ORIGINS=https://agni.app,https://www.agni.app

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
